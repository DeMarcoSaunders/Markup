@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find raylib dependency
find_dependency(raylib REQUIRED)

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/MarkUpUITargets.cmake")

# Set variables for backward compatibility
set(MARKUP_UI_LIBRARIES MarkUpUI::markup-ui)
set(MARKUP_UI_INCLUDE_DIRS "@PACKAGE_INCLUDE_INSTALL_DIR@")

check_required_components(MarkUpUI)
